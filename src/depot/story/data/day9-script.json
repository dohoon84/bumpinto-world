[{"id":"d9_000","cmd":"scene.start","day":9,"week":2,"title":"할머니 대 시식 부대","subtitle":"떡볶이 수레는 천천히","ui":"daycard","bg":"entrance","bgm":"hold","sfx":"door-chime","next":"d9_002"},{"id":"d9_002","cmd":"branch","on":"ev.E15","cases":{"success":"d9_003","partial":"d9_003","fail":"d9_004","missed":"d9_004"},"default":"d9_004"},{"id":"d9_003","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"어제 행렬 뚫은 거, 직원 단톡방에 올렸어요!","next":"d9_005"},{"id":"d9_004","speaker":"beomi","expression":"neutral","pos":"right","enter":"jump","fx":"sweat","text":"어제 보라 행렬이 꿈에 나왔어요. 저도 끼어 있었어요.","next":"d9_005"},{"id":"d9_005","cmd":"branch","on":"ev.E16","cases":{"success":"d9_006","partial":"d9_006","fail":"d9_007","missed":"d9_007"},"default":"d9_007"},{"id":"d9_006","speaker":"narration","text":"입구에 '보라 전단지 재활용함'. 벌써 반쯤 찼다.","next":"d9_008"},{"id":"d9_007","speaker":"narration","text":"입구 바닥에 보라 전단지 한 장이 아직 붙어 있다.","next":"d9_008"},{"id":"d9_008","speaker":"narration","bgm":"bgm.tailing","text":"자동문 밖 보도에 보라 천막. '무료 시식' 깃발이 펄럭인다.","next":"d9_009"},{"id":"d9_009","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「입구 밖 천막은… 저희 것이 아닙니다. 저희 것이 아닙니다.」","next":"d9_010"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d9_010","expression":"laugh","pos":"right","enter":"slide","sfx":"motif.rivalboss","stage":{"rivalboss":"rival-tent"},"text":"오늘은 시식 견학이에요. 우리 떡꼬치, 공짜예요.","next":"d9_011"},{"id":"d9_011","speaker":"halmeoni","expression":"neutral","pos":"left","enter":"slide","text":"공짜는 나도 공짜야. 시식이니까.","next":"d9_012"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d9_012","expression":"surprised","pos":"right","text":"…할머니, 혹시 예전에 시장 쪽에서—","next":"d9_013"},{"id":"d9_013","speaker":"halmeoni","expression":"neutral","pos":"left","text":"응? 시장 쪽에 분식집 하나 있었지. 왜?","next":"d9_014"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d9_014","expression":"neutral","pos":"right","sfx":"stopwatch-click","text":"아니에요. 어느 쪽 줄이 긴지 재겠습니다.","next":"d9_015"},{"id":"d9_015","speaker":"