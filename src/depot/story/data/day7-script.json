[{"id":"d7_000","cmd":"scene.start","day":7,"title":"본사 감사의 날","subtitle":"일요일. 체크리스트 다섯 칸","ui":"daycard","bg":"entrance","bgm":"hold","sfx":"door-chime","next":"d7_002"},{"id":"d7_002","cmd":"branch","on":"ev.E07","cases":{"success":"d7_003","partial":"d7_004","fail":"d7_004","missed":"d7_005"},"default":"d7_005"},{"id":"d7_003","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"카트 열 대 정리 다 했어요! 아침 여섯 시에요! 뿌듯해요!","fx":"sweat","next":"d7_006"},{"id":"d7_004","speaker":"beomi","expression":"neutral","pos":"right","enter":"jump","text":"어제 경주 다시 하고 싶어요. 오늘 말고요. 오늘은 안 돼요.","next":"d7_006"},{"id":"d7_005","speaker":"beomi","expression":"neutral","pos":"right","enter":"jump","text":"어제 혼자 한 바퀴 돌았는데요… 쌀 포대가 저를 이겼어요.","fx":"sweat","next":"d7_006"},{"id":"d7_006","cmd":"branch","on":"ev.E08","cases":{"success":"d7_007","partial":"d7_007","fail":"d7_008","missed":"d7_008"},"default":"d7_008"},{"id":"d7_007","speaker":"narration","text":"뒤쪽 벽에 금빛 '비밀 창고' 표식. 아무도 설명하지 않는다.","next":"d7_010"},{"id":"d7_008","speaker":"narration","text":"뒤쪽 벽에 희미한 표식 하나. 아무도 설명하지 않는다.","next":"d7_010"},{"id":"d7_010","speaker":"narration","bgm":"bgm.audit","sfx":"motif.auditor","text":"입구에 남색 정장이 서 있다. 태블릿을 든 채, 표정이 없다.","next":"d7_011"},{"speaker":"auditor","nameTag":"본사 감사관","id":"d7_011","expression":"neutral","pos":"right","enter":"slide","text":"본사 감사팀입니다. 오늘은 손님 한 분을 보겠습니다.","next":"d7_012"},{"speaker":"auditor","nameTag":"본사 감사관","id":"d7_012","expression":"neutral","pos":"right","sfx":"tablet-tap","text":"입장부터 계산까지. 처음부터 끝까지요.","next":"d7_013"},{"id":"d7_013","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"jump","text":"그, 그 손님이… 지금 들어오신 분인가요?","fx":"sweat","next":"d7_014"},{"speaker":"auditor","nameTag":"본사 감사관","id":"d7_014","expression":"neutral","pos":"right","text":"네. 평소처럼 장 보시면 됩니다. 저는 뒤에 있겠습니다.","next":"d7_015"},{"id":"d7_015","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「감, 감사관님 환영합니다. 저희 매장은… 평소처럼 평소입니다.」","next":"d7_016"},{"id":"d7_016","speaker":"me","text":"(점장님 목소리가 떨린다. 1일차엔 이러지 않았는데.)","next":"d7_017"},{"id":"d7_017","speaker":"beomsuk","expression":"neutral","pos":"left","text":"손님, 감사 체크리스트는 다섯 개예요. 제가 외웠어요.","next":"d7_018"},{"id":"d7_018","speaker":"beomsuk","expression":"neutral","pos":"left","ui":"checklist","text":"하나, 깨진 알 0개. 둘, 카트 적재율 85% 이상.","emph":["0개","85%"],"next":"d7_019"},{"id":"d7_019","speaker":"beomsuk","expression":"neutral","pos":"left","ui":"checklist","text":"셋, 카트 포함 200kg. 넷, 방해 세 번 피하기.","emph":["200kg","세 번"],"next":"d7_020"},{"id":"d7_020","speaker":"beomsuk","expression":"angry","pos":"left","ui":"checklist","text":"다섯, 10분 안에 계산. …네 개면 통과예요.","emph":["10분","네 개"],"fx":"anger","next":"d7_021"},{"id":"d7_021","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","text":"방해요? 누가 방해를 해요? …아.","next":"d7_022"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d7_022","expression":"laugh","pos":"right","enter":"slide","sfx":"motif.spy","text":"약속대로 더 큰 카트로 왔소. 오늘이 일요일이니까.","emph":["더 큰 카트"],"next":"d7_023"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d7_023","expression":"neutral","pos":"right","text":"통로 세 곳을 막겠소. 경쟁 마트의 마지막 조사요.","next":"d7_024"},{"speaker":"auditor","nameTag":"본사 감사관","id":"d7_024","expression":"neutral","pos":"left","enter":"slide","sfx":"tablet-tap","text":"…손님이 손님을 막는 것도 매장 상황입니다. 기록하죠.","next":"d7_025"},{"id":"d7_025","cmd":"branch","on":"ev.E08","cases":{"success":"d7_026","partial":"d7_026","fail":"d7_027","missed":"d7_027"},"default":"d7_027"},{"id":"d7_026","speaker":"halmeoni","expression":"laugh","pos":"right","enter":"slide","text":"쪽지대로면 냉동 코너 맨 아래 칸이야. 딱 하나 있대.","emph":["맨 아래 칸"],"next":"d7_028"},{"id":"d7_027","speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","text":"어젯밤 그 상자 말이야. 냉동 코너 맨 아래 칸, 기억나.","emph":["맨 아래 칸"],"next":"d7_028"},{"id":"d7_028","speaker":"halmeoni","expression":"neutral","pos":"right","text":"꺼내면 녹기 시작해. 150초 안에 계산해야 해. 살살.","emph":["150초"],"next":"d7_029"},{"id":"d7_029","choices":[{"text":"(카트 손잡이를 꽉 잡는다) 시작할게요","goto":"d7_031","chip":"감사 시작","set":{"aff.beomsuk":1}},{"text":"감사관님, 몇 개 보세요?","goto":"d7_030"}]},{"speaker":"auditor","nameTag":"본사 감사관","id":"d7_030","expression":"neutral","pos":"right","text":"다 봅니다. 그런데 손님이 즐거운지도 봅니다.","next":"d7_031"},{"id":"d7_031","cmd":"mission.start","event":"E11","ui":"mission-card","text":"","target":"checkout","audit":{"checklist":[{"id":"c1","label":"깨진 알 0개","judge":"eggsToday(감사 시작 뒤) == 0"},{"id":"c2","label":"적재율 85% 이상","judge":"계산대 도착 때 loadRatio >= 0.85 (적재율 링 값)"},{"id":"c3","label":"카트 포함 200kg","judge":"계산 때 cartKg + 27 >= 200 (= E10)","event":"E10"},{"id":"c4","label":"반값 방해 3번 피하기","judge":"spyBlocks 3개 모두 dodged"},{"id":"c5","label":"10분 안에 계산","judge":"감사 시작 → checkout.done <= 600초"}],"pass":{"success":">=4","partial":"2-3","fail":"0-1"},"spyBlocks":[{"id":"b1","target":"spy-block-1","after":45,"triggerDistM":15,"line":"여긴 못 지나가오. 내 카트가 더 크니까.","sfx":"motif.spy"},{"id":"b2","target":"spy-block-2","after":180,"triggerDistM":15,"line":"두 번째 길목이오. 돌아가시오, 아니면 미시오.","sfx":"motif.spy"},{"id":"b3","target":"spy-block-3","after":330,"triggerDistM":15,"line":"마지막이오! …이 카트, 사실 좀 무겁소.","sfx":"motif.spy"}],"dodgeRule":"막은 뒤 20초 안에 반기철 카트를 안 밀고(rams·bumpTarget spy 0) 다음 체크 위치 4 m 안에 들어가면 피함. 밀면 rams +1, 그 방해는 실패","auditorFollow":{"who":"auditor","startAt":"auditor-post","distM":6,"note":"감사관 NPC 가 6 m 뒤에서 따라다님(충돌 없음)"}},"sideMissions":[{"event":"E09","trigger":"pickup","item":"legend-icecream","target":"freezer-legend","timeLimitSec":150,"meltBasePctPerSec":0.3,"bumpMeltPct":5,"crush":"계란과 같은 압력 판정, 눌리면 +20%","endsAt":"checkout.done"},{"event":"E10","trigger":"checkout","targetKg":200,"note":"체크 c3 과 같은 값. 따로 시작하지 않음"}],"resolve":"checkout","timeLimitSec":600,"resume":"d7_039","onCheckout":"d7_039","bgm":"bgm.audit","timed":[{"t":10,"speaker":"beomi","text":"할머니가 냉동 코너에서 기다리세요! 동쪽 벽이요!"},{"t":120,"speaker":"auditor","nameTag":"본사 감사관","sfx":"tablet-tap","text":"(톡, 톡.)"},{"t":300,"speaker":"beomsuk","text":"5분 지났어요. 200kg… 범쌀이 제일 무거워요."},{"t":540,"speaker":"beomi","sfx":"timer-tick","text":"1분 남았어요! 계산대로요!"}],"next":"d7_039"},{"id":"d7_039","cmd":"scene.checkout","text":"","next":"d7_040"},{"id":"d7_040","cmd":"branch","on":"mission.E10.result","cases":{"success":"d7_041","partial":"d7_044","fail":"d7_046"},"default":"d7_046"},{"id":"d7_041","speaker":"cashier","expression":"surprised","pos":"right","enter":"jump","sfx":"item-place","text":"저울이… 200kg 넘었어요! 카트 포함!","emph":["200kg"],"fx":"exclaim","next":"d7_042"},{"id":"d7_042","speaker":"narration","sfx":"applause","bgm":"bgm.emotional","text":"계산대 네 곳에서 직원들이 일어섰다. 기립박수.","next":"d7_043"},{"id":"d7_043","speaker":"beomsuk","expression":"laugh","pos":"left","enter":"slide","sfx":"achievement","text":"…박수는 원칙에 없지만. 오늘은 쳐요.","next":"d7_048"},{"id":"d7_044","speaker":"cashier","expression":"laugh","pos":"right","enter":"slide","sfx":"applause","text":"200kg 넘었어요! …계란 몇 알은 못 버텼지만요~","next":"d7_045"},{"id":"d7_045","speaker":"beomi","expression":"laugh","pos":"right","text":"박수는 쳐요! 반만 일어나서 쳐요!","next":"d7_048"},{"id":"d7_046","speaker":"cashier","expression":"neutral","pos":"right","enter":"slide","text":"이번 카트는… 200kg까지 조금 모자라요.","next":"d7_047"},{"id":"d7_047","speaker":"beomi","expression":"neutral","pos":"right","enter":"slide","text":"박수 준비했는데… 그래도 조금 칠게요. 짝짝.","fx":"sweat","next":"d7_048"},{"id":"d7_048","cmd":"branch","on":"mission.E09.result","cases":{"success":"d7_049","partial":"d7_052","fail":"d7_054","missed":"d7_056"},"default":"d7_056"},{"id":"d7_049","speaker":"halmeoni","expression":"surprised","pos":"right","enter":"jump","bgm":"bgm.legend","text":"안 녹았어! 이 모양 그대로야. 그때 그 맛이야.","fx":"sparkle","next":"d7_050"},{"id":"d7_050","speaker":"halmeoni","expression":"laugh","pos":"right","sfx":"achievement","text":"고마워. 냉동 코너에 '오늘의 전설' 칸을 만들자.","emph":["오늘의 전설"],"next":"d7_051"},{"id":"d7_051","speaker":"beomsuk","expression":"surprised","pos":"left","text":"할머니… 이거 제가 꼬마 때 반 나눠 주셨던 거죠?","next":