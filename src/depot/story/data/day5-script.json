[{"id":"d5_000","cmd":"scene.start","day":5,"title":"미행","subtitle":"보라 모자를 따라가라. 단, 들키지 말 것","ui":"daycard","bg":"entrance","bgm":"hold","sfx":"door-chime","next":"d5_003"},{"id":"d5_003","speaker":"narration","text":"생활용품 코너가 넓어졌다. 피라미드는 두 배, 높이는 무릎까지.","next":"d5_004"},{"id":"d5_004","cmd":"branch","on":"ev.E04","cases":{"success":"d5_005","partial":"d5_005","fail":"d5_006","missed":"d5_006"},"default":"d5_006"},{"id":"d5_005","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"재고 담당 선배도 새로 왔어요! 손님 덕분이래요!","next":"d5_007"},{"id":"d5_006","speaker":"beomi","expression":"neutral","pos":"right","enter":"jump","text":"재고 담당 선배가 새로 왔어요. 저는 휴지 쌓기 금지래요…","fx":"sweat","next":"d5_007"},{"id":"d5_007","cmd":"branch","on":"ev.E12","cases":{"success":"d5_008","partial":"d5_008","fail":"d5_009","missed":"d5_009"},"default":"d5_009"},{"id":"d5_008","speaker":"narration","text":"고객센터 유리창에 크레용 그림. 큰 카트에 탄 꼬마와 손님.","next":"d5_010"},{"id":"d5_009","speaker":"narration","text":"고객센터 유리창에 크레용 그림. 범이 등에 업힌 꼬마.","next":"d5_010"},{"id":"d5_010","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","text":"손님, 어제 말한 그 부탁이요.","next":"d5_011"},{"id":"d5_011","speaker":"beomsuk","expression":"neutral","pos":"left","text":"보라 모자 손님, 오늘도 왔어요. 지금 통로 01에 있어요.","emph":["통로 01"],"next":"d5_012"},{"id":"d5_012","speaker":"beomsuk","expression":"angry","pos":"left","text":"매일 특가만 쓸어 가요. 뭐 하는 사람인지 알아내야 해요.","fx":"anger","next":"d5_013"},{"id":"d5_013","speaker":"beomi","expression":"neutral","pos":"right","enter":"slide","text":"특가 상품을 열 번째 담는 순간, 딱 한 장만 찍어 주세요!","emph":["열 번째"],"next":"d5_014"},{"id":"d5_014","speaker":"beomsuk","expression":"neutral","pos":"left","text":"4m보다 가까우면 들켜요. 12m보다 멀면 놓쳐요.","emph":["4m","12m"],"next":"d5_015"},{"id":"d5_015","speaker":"beomi","expression":"neutral","pos":"right","text":"랙 끝에 숨으면 덜 수상해요. 카트 쿵 하면 바로 들켜요!","next":"d5_016"},{"id":"d5_016","choices":[{"text":"(선글라스를 쓴다) 맡겨 주세요","goto":"d5_018","chip":"미션 수락","set":{"aff.beomsuk":1}},{"text":"손님을 몰래 찍어도 돼요?","goto":"d5_017"}]},{"id":"d5_017","speaker":"beomsuk","expression":"neutral","pos":"left","text":"특가 매대에서 담는 장면만요. 그 밖엔 안 찍어요. 원칙이에요.","next":"d5_018"},{"id":"d5_018","cmd":"mission.start","event":"E05","ui":"mission-card","text":"","target":"timesale-endcap","follow":{"who":"spy","startAt":"aisle-01-water","route":["aisle-01-water","aisle-02-rice","aisle-02-household","massage-chair","timesale-endcap"],"minDistM":4,"maxDistM":12,"loseSec":10,"spottedMax":2,"photoAtGrab":10,"grabs":10,"photo":{"pc":"F","mobile":"촬영 버튼","windowSec":2.0}},"resolve":"follow","timeLimitSec":90,"resume":"d5_020","onMissed":"d5_026","onCheckout":"d5_088","bgm":"bgm.tailing","timed":[{"t":5,"speaker":"beomi","text":"쉿… 저는 여기서 안 보이는 척할게요."},{"speaker":"spy","nameTag":"수상한 손님","t":30,"expression":"laugh","text":"(혼잣말) 다섯… 여섯… 오늘 특가도 내 거다."},{"t":60,"speaker":"beomsuk","text":"곧 특가 매대예요. 거기서 열 번째일 거예요."},{"t":80,"speaker":"beomi","text":"지금이에요! 찍을 준비요!"}],"next":"d5_020"},{"id":"d5_020","cmd":"branch","on":"mission.E05.result","cases":{"success":"d5_021","partial":"d5_023","fail":"d5_025","missed":"d5_026"}},{"id":"d5_021","speaker":"narration","sfx":"camera-shutter","text":"찰칵. 보라 장바구니 안에 노란 스티커 상품이 열 개.","next":"d5_022"},{"id":"d5_022","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"slide","sfx":"stinger.success","text":"찍혔어요. 열 개 전부 우리 특가예요. 이제 말해 주시죠.","next":"d5_030"},{"speaker":"spy","nameTag":"수상한 손님","id":"d5_023","expression":"surprised","pos":"right","enter":"jump","sfx":"stinger.spotted","text":"거기 카트! 아까부터 따라… 찰칵? 지금 찍었소?!","fx":"exclaim","next":"d5_024"},{"id":"d5_024","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","sfx":"stinger.partial","text":"들키긴 했지만 찍혔어요. 열 개 전부요.","next":"d5_030"},{"speaker":"spy","nameTag":"수상한 손님","id":"d5_025","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.spotted","text":"후후, 미행이 서툴군. 카트 바퀴 소리가 다 들렸소!","next":"d5_025b"},{"id":"d5_025b","speaker":"beomsuk","expression":"angry","pos":"left","enter":"slide","text":"…놓쳤네요. 그런데 저 사람, 왜 자기 발로 걸어오죠?","next":"d5_030"},{"id":"d5_026","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","bgm":"bgm.shop","text":"미행은 못 했네요. …괜찮아요, 저 사람이 알아서 왔어요.","next":"d5_030"},{"speaker":"spy","nameTag":"수상한 손님","id":"d5_030","expression":"angry","pos":"right","enter":"slide","bgm":"bgm.tailing","text":"좋소. 이렇게 된 이상 정체를 밝히지.","next":"d5_031"},{"id":"d5_031","cmd":"sfx","sfx":"stinger.reveal","next":"d5_032"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_032","expression":"laugh","pos":"right","fx":"sparkle","text":"나는 경쟁 마트 조사 요원, 반기철. 다들 '반값'이라 부르지.","emph":["반기철"],"next":"d5_033"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_033","expression":"neutral","pos":"right","text":"여기 특가가 너무 싸서 윗선이 날 보냈소. 일요일까지.","emph":["일요일까지"],"next":"d5_034"},{"id":"d5_034","speaker":"beomsuk","expression":"angry","pos":"left","text":"그래서 우리 상품에 스티커를 붙이고 다니셨어요?","fx":"anger","next":"d5_035"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_035","expression":"surprised","pos":"right","fx":"sweat","text":"그건… 반값 스티커가 붙어 있으면 왠지 싸 보이잖소.","next":"d5_036"},{"id":"d5_036","choices":[{"text":"앞으로는 계산하고 붙이세요","goto":"d5_037","set":{"flag.spyRevealed":1,"aff.spy":1}},{"text":"주임님, 출입 금지 시켜요","goto":"d5_038","set":{"flag.spyRevealed":1,"aff.beomsuk":1}},{"text":"(사진을 보여 주며) 이거 액자로 걸게요","goto":"d5_039","set":{"flag.spyRevealed":1,"aff.beomi":1}}]},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_037","expression":"laugh","pos":"right","text":"…계산은 늘 했소. 나는 정직한 요원이오.","next":"d5_040"},{"id":"d5_038","speaker":"beomsuk","expression":"neutral","pos":"left","text":"물건 사는 손님은 못 막아요. 원칙이에요. …아쉽지만.","next":"d5_040"},{"id":"d5_039","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"'오늘의 손님' 칠판 옆에 걸게요! 제목은 '열 번째'!","next":"d5_040"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_040","expression":"neutral","pos":"right","text":"기억하시오. 일요일엔 더 큰 카트로 오겠소.","next":"d5_041"},{"id":"d5_041","speaker":"narration","text":"반기철은 빗자루 배지를 반짝이며 통로 끝으로 사라졌다.","next":"d5_045"},{"id":"d5_045","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「아, 아. 방금 바닥 청소를 마쳤습니다. 그래서 지금부터…」","next":"d5_046"},{"id":"d5_046","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「노란 선 밖은 용암입니다. 농담 아닙니다. 아마도.」","next":"d5_047"},{"id":"d5_047","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","text":"점장님 또 시작했어요! 통로 01 노란 선 보이시죠?","fx":"exclaim","next":"d5_048"},{"id":"d5_048","speaker":"beomi","expression":"neutral","pos":"right","text":"선 안으로만 범샘물 세 팩, 계산대 앞 노란 띠까지! 1분이요!","emph":["세 팩","1분"],"next":"d5_049"},{"id":"d5_049","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","text":"…저는 안 해요. 근데 선은 밟지 마세요. 그냥요.","next":"d5_050"},{"id":"d5_050","choices":[{"text":"바닥은 용암이다!","goto":"d5_052","chip":"미션 수락","set":{"aff.beomi":1}},{"text":"어른이 이런 걸 왜 해요","goto":"d5_051"}]},{"id":"d5_051","speaker":"beomi","expression":"laugh","pos":"right","text":"어른이라서 하는 거예요! 점장님도 어른이에요!","next":"d5_052"},{"id":"d5_052","cmd":"mission.start","event":"E06","ui":"mission-card","text":"","target":"lava-goal","waypoints":[{"target":"aisle-01-water","item":"water","n":3,"label":"범샘물 2L×6 3팩"}],"lava":{"safeZones":["lava-lane-01","lava-link-01","lava-front-band","lava-goal"],"startOn":"enterSafe","outsideOkSec":0,"outsideFailSec":3,"wheelRule":"바퀴 4개 중 하나라도 선 밖이면 선 밖"},"resolve":"arrive","timeLimitSec":60,"resume":"d5_060","onMissed":"d5_066","onCheckout":"d5_088","bgm":"bgm.lava","timed":[{"t":10,"speaker":"pa","sfx":"pa-chime","text":"「용암 온도, 아주 뜨겁습니다. 느낌상.」"},{"t":30,"speaker":"beomi","text":"30초요! 돌 때 크게 도세요, 물 무거워요!"},{"t":50,"speaker":"pa","sfx":"pa-chime","text":"「10초! 9! 8! …숫자는 범이 씨에게 넘깁니다.」"}],"next":"d5_060"},{"id":"d5_060","cmd":"branch","on":"mission.E06.result","cases":{"success":"d5_061","partial":"d5_063","fail":"d5_064","missed":"d5_066"}},{"id":"d5_061","cmd":"pa","sfx":"achievement","speaker":"pa","text":"「축하합니다. 용암 위를 건넌 첫 손님입니다.」","next":"d5_062"},{"id":"d5_062","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"업적 땄어요! '용암 위의 장보기'! 저는 두 번 빠졌어요!","fx":"sparkle","bgm":"bgm.shop","next":"d5_072"},{"id":"d5_063","speaker":"beomi","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.partial","bgm":"bgm.shop","text":"발끝만 살짝 데였어요! 그 정도는 용암 아니에요!","next":"d5_072"},{"id":"d5_064","speaker":"beomi","expression":"surprised","pos":"right","enter":"slide","sfx":"stinger.comicfail","bgm":"bgm.shop","text":"카트가 용암에 퐁당! …농담이에요. 그냥 바닥이에요.","fx":"sweat","next":"d5_065"},{"id":"d5_065","speaker":"beomsuk","expression":"angry","pos":"left","enter":"slide","text":"점장님, 손님을 녹이지 마세요.","fx":"anger","next":"d5_072"},{"id":"d5_066","cmd":"pa","sfx":"pa-chime","speaker":"pa","bgm":"bgm.shop","text":"「…아무도 용암에 안 오셨습니다. 방송을 접겠습니다.」","next":"d5_072"},{"id":"d5_072","speaker":"halmeoni","expression":"laugh","pos":"right","enter":"slide","sfx":"sample-tray","text":"범콜라 화채야. 오늘처럼 뛰어다닌 날엔 시원한 게 좋지.","next":"d5_073"},{"id":"d5_073","speaker":"halmeoni","expression":"neutral","pos":"right","text":"범숙이는 꼬마 때도 화채 얼음을 하나씩 세서 먹었어.","next":"d5_074"},{"id":"d5_074","speaker":"halmeoni","expression":"laugh","pos":"right","text":"원칙주의는 그때부터였지.","next":"d5_075"},{"id":"d5_075","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"slide","text":"할머니… 미행보다 그게 더 들키면 안 되는 거예요.","fx":"sweat","next":"d5_076"},{"id":"d5_076","choices":[{"text":"얼음 몇 개 드릴까요, 주임님?","goto":"d5_077","set":{"aff.beomsuk":1}},{"text":"(조용히 화채를 마신다)","goto":"d5_078","set":{"aff.halmeoni":1}}]},{"id":"d5_077","speaker":"beomsuk","expression":"laugh","pos":"left","text":"…세 개요. 딱 세 개.","next":"d5_079"},{"id":"d5_078","speaker":"halmeoni","expression":"laugh","pos":"right","text":"잘 먹네. 하나 더 먹고 가.","next":"d5_079"},{"id":"d5_079","cmd":"scene.checkout","text":"","next":"d5_081"},{"id":"d5_081","speaker":"cashier","expression":"laugh","pos":"right","enter":"slide","sfx":"checkout-scan","text":"손님, 오늘 탐정이셨다면서요? 계산대까지 소문났어요~","next":"d5_082"},{"id":"d5_082","speaker":"cashier","expression":"neutral","pos":"right","text":"그 반값 손님, 제 줄에선 늘 봉투 사양해요. 장바구니파래요.","next":"d5_083"},{"id":"d5_083","speaker":"me","text":"(…경쟁 마트 요원치고는, 매너가 좋다.)","next":"d5_090"},{"id":"d5_088","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"slide","text":"벌써 계산하세요? 그 보라 모자, 지금 옆 계산대에 있어요.","next":"d5_089"},{"speaker":"spy","nameTag":"수상한 손님","id":"d5_089","expression":"laugh","pos":"right","enter":"slide","text":"미행도 없이 끝이라니 섭섭하군. 그럼 내가 밝히지.","next":"d5_089b"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d5_089b","expression":"laugh","pos":"right","fx":"sparkle","sfx":"stinger.reveal","text":"나는 경쟁 마트 조사 요원, 반기철. 다들 '반값'이라 부르지.","next":"d5_089c"},{"id":"d5_089c","choices":[{"text":"(…네?)","goto":"d5_090","set":{"flag.spyRevealed":1}}]},{"id":"d5_090","cmd":"pa","sfx":"pa-chime","speaker":"pa","bgm":"bgm.closing","text":"「계산 감사합니다. 용암은 식었습니다. 노란 선은 내일도 지켜 주세요.」","next":"d5_091"},{"id":"d5_091","speaker":"narration","text":"방송실 창문 블라인드가 반쯤 올라갔다. 실루엣만 보인다.","next":"d5_092"},{"id":"d5_092","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"손님! 내일은 마감 후에 남아 주세요. 카트 경주 한 판이요!","emph":["마감 후"],"next":"d5_093"},{"id":"d5_093","speaker":"beomsuk","expression":"angry","pos":"left","enter":"slide","text":"범이야, 마감 후엔 퇴근이야.","fx":"anger","next":"d5_094"},{"id":"d5_094","speaker":"beomsuk","expression":"neutral","pos":"left","text":"…경주할 거면 50kg 넘게 싣고 해. 무거워야 안 넘어져.","emph":["50kg"],"next":"d5_095"},{"id":"d5_095","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「내일 예고. 마감 후 특별 행사. 새벽 세 시엔… 아무 일도 없습니다.」","next":"d5_096"},{"id":"d5_096","choices":[{"text":"내일 마감까지 있을게요","goto":"d5_097","set":{"aff.beomi":1}},{"text":"새벽 세 시요?","goto":"d5_098"}]},{"id":"d5_097","speaker":"beomi","expression":"laugh","pos":"right","text":"약속이에요! 지는 사람이 카트 열 대 정리!","next":"d5_100"},{"id":"d5_098","speaker":"beomsuk","expression":"surprised","pos":"left","text":"…그 시간엔 창고 뒤쪽 벽이 가끔 울려요. 신경 쓰지 마세요.","next":"d5_100"},{"id":"d5_100","cmd":"day.end","stamp":1,"vitality":"by_result","storeChange":"통로 끝 볼록거울 설치, 커플·휴대폰 손님 등장, 방송실 창문 블라인드 반쯤 열림(실루엣만), 인물 카드 '반기철(반값)' 공개","ui":"stamp-card","text":"","nextDay":{"day":6,"title":"마감 후","hook":"불 꺼진 매장, 카트 경주 세 바퀴… 그리고 새벽 3시의 소리","ui":"next-day-card","sfx":"stinger.nextday"},"next":"d6_000"}]