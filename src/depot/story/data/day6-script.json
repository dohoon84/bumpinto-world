[{"id":"d6_000","cmd":"scene.start","day":6,"title":"마감 후","subtitle":"불 꺼진 매장, 세 바퀴. 그리고 새벽 세 시","ui":"daycard","bg":"entrance","bgm":"hold","sfx":"door-chime","next":"d6_002"},{"id":"d6_002","speaker":"narration","text":"통로 끝에 볼록거울이 달렸다. 계산대 쪽엔 '열 번째' 칸이 비어 있다.","next":"d6_003"},{"id":"d6_003","cmd":"branch","on":"ev.E05","cases":{"success":"d6_004","partial":"d6_004","fail":"d6_005","missed":"d6_005"},"default":"d6_005"},{"id":"d6_004","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"'열 번째' 사진 걸었어요! 반값 아저씨 표정 최고예요!","next":"d6_006"},{"id":"d6_005","speaker":"beomi","expression":"neutral","pos":"right","enter":"jump","text":"사진은 없지만 액자는 걸었어요. 제목만 '열 번째'예요.","fx":"sweat","next":"d6_006"},{"id":"d6_006","cmd":"branch","on":"ev.E06","cases":{"success":"d6_007","partial":"d6_008","fail":"d6_008","missed":"d6_009"},"default":"d6_009"},{"id":"d6_007","speaker":"beomi","expression":"laugh","pos":"right","text":"저 아침에 노란 선만 밟고 출근했어요. 손님 따라 한 거예요!","next":"d6_010"},{"id":"d6_008","speaker":"beomi","expression":"neutral","pos":"right","text":"어제 용암은… 점장님이 바닥 온도 낮췄대요. 마음으로요.","next":"d6_010"},{"id":"d6_009","speaker":"beomi","expression":"neutral","pos":"right","text":"어제 용암 방송, 점장님 혼자 끝까지 했대요. 쓸쓸했대요.","next":"d6_010"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d6_010","expression":"neutral","pos":"left","enter":"slide","text":"(볼록거울 속) …이 거울, 나 때문에 단 거요? 영광이군.","next":"d6_011"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d6_011","expression":"laugh","pos":"left","text":"내일이 일요일이오. 더 큰 카트, 잊지 마시오.","emph":["일요일"],"next":"d6_012"},{"id":"d6_012","speaker":"beomsuk","expression":"angry","pos":"left","enter":"slide","text":"장 보러 왔으면 장만 보세요, 반기철 씨.","fx":"anger","next":"d6_013"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d6_013","expression":"surprised","pos":"left","fx":"sweat","text":"…실명으로 부르지 마시오. 반값이라 불러 주시오.","next":"d6_014"},{"id":"d6_014","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","text":"손님! 오늘 마감 후 경주 약속 기억하시죠? 세 바퀴요!","emph":["세 바퀴"],"next":"d6_015"},{"id":"d6_015","speaker":"beomsuk","expression":"neutral","pos":"left","text":"…경주는 계산 끝나고. 매장 불 반 끄고 나서요.","next":"d6_016"},{"id":"d6_016","choices":[{"text":"좋아요, 마감까지 있을게요","goto":"d6_017","chip":"약속","set":{"aff.beomi":1}},{"text":"주임님도 하세요?","goto":"d6_018"}]},{"id":"d6_017","speaker":"beomi","expression":"laugh","pos":"right","text":"지는 사람이 카트 열 대 정리! 어제 한 말 유효해요!","next":"d6_020"},{"id":"d6_018","speaker":"beomsuk","expression":"surprised","pos":"left","text":"제가요? …심판은 볼게요. 출발 신호는 제가 해요.","fx":"sweat","next":"d6_020"},{"id":"d6_020","cmd":"roam","until":{"sec":150},"text":"","hint":"경주는 계산 뒤에 시작해요. 천천히 장 보세요","next":"d6_022"},{"id":"d6_022","speaker":"cashier","expression":"laugh","pos":"right","enter":"slide","text":"오늘 마감 후에 경주한다면서요? 저 07번에서 응원할게요~","next":"d6_023"},{"id":"d6_023","cmd":"scene.checkout","text":"","next":"d6_025"},{"id":"d6_025","speaker":"cashier","expression":"neutral","pos":"right","sfx":"checkout-printer","text":"영수증 뒤에 경주 코스 그려 드렸어요. 범이 씨가 부탁했대요.","next":"d6_026"},{"id":"d6_026","cmd":"pa","sfx":"pa-chime","speaker":"pa","bgm":"bgm.closing","text":"「영업을 마칩니다. 남은 분은… 남아 주셔도 됩니다.」","next":"d6_027"},{"id":"d6_027","speaker":"narration","text":"천장 불이 한 줄씩 꺼졌다. 메인 통로에만 주황 불빛이 남는다.","next":"d6_028"},{"id":"d6_028","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","bgm":"bgm.cartrace","text":"코스 설명할게요! 메인 통로 → 특가 매대 → 통로 01 → 출발선!","next":"d6_029"},{"id":"d6_029","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","text":"카트에 50kg 넘게 실어요. 통로 02 범쌀 세 포대면 60kg이에요.","emph":["50kg"],"next":"d6_030"},{"id":"d6_030","speaker":"beomsuk","expression":"angry","pos":"left","text":"통로 01 계란 코너에서 쏟으면… 경주 끝이에요.","fx":"anger","next":"d6_031"},{"id":"d6_031","speaker":"beomi","expression":"neutral","pos":"right","text":"75초 안에 세 바퀴! 저보다 먼저 들어오면 손님 승!","emph":["75초"],"next":"d6_032"},{"id":"d6_032","choices":[{"text":"출발선으로 간다","goto":"d6_034","chip":"미션 수락","set":{"aff.beomi":1}},{"text":"무거우면 더 느리잖아요","goto":"d6_033"},{"text":"오늘은 그냥 퇴근할게요","goto":"d6_048"}]},{"id":"d6_033","speaker":"beomsuk","expression":"neutral","pos":"left","text":"대신 코너에서 안 넘어져요. 무거워야 안 넘어져요.","next":"d6_034"},{"id":"d6_034","cmd":"mission.start","event":"E07","ui":"mission-card","text":"","target":"race-start","waypoints":[{"target":"aisle-02-rice","item":"rice","n":3,"label":"범쌀 20kg 3포대(재고, 계산 안 함)","stock":true}],"race":{"start":"race-start","finish":"race-start","checkpoints":["timesale-endcap","aisle-01-eggs"],"laps":3,"minLoadKg":50,"rival":{"who":"beomi","cartKg":35,"stumbles":2,"stumbleAtLap":[1,3]},"countdown":3,"startCheck":"카트 짐 50kg 미만이면 출발선에서 막음(d6_035)"},"resolve":"race","timeLimitSec":75,"startWithinSec":90,"resume":"d6_040","onMissed":"d6_048","onLowLoad":"d6_035","bgm":"bgm.cartrace","timed":[{"t":0,"speaker":"beomsuk","sfx":"race-countdown","text":"셋, 둘, 하나… 출발!"},{"t":20,"speaker":"beomi","text":"으아아아! 코너에서 쌀이 쏠려요!"},{"t":40,"speaker":"pa","sfx":"pa-chime","text":"「(속삭임) …현재 1위는… 비밀입니다.」"},{"t":65,"speaker":"beomsuk","text":"10초! 계란 코너 조심!"}],"next":"d6_040"},{"id":"d6_035","speaker":"beomsuk","expression":"neutral","pos":"left","text":"아직 50kg 안 돼요. 범쌀 한 포대 더요.","next":"d6_034"},{"id":"d6_040","cmd":"branch","on":"mission.E07.result","cases":{"success":"d6_041","partial":"d6_043","fail":"d6_045","missed":"d6_048"}},{"id":"d6_041","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","sfx":"applause","text":"졌어요… 60kg 싣고 어떻게 그렇게 돌아요?!","fx":"exclaim","next":"d6_042"},{"id":"d6_042","speaker":"beomsuk","expression":"laugh","pos":"left","enter":"slide","sfx":"stinger.success","text":"손님 승. 범이야, 카트 열 대. 지금.","next":"d6_050"},{"id":"d6_043","speaker":"beomi","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.partial","text":"아슬아슬했어요! 쌀 포대가 좀 굴렀지만 멋졌어요!","next":"d6_044"},{"id":"d6_044","speaker":"beomsuk","expression":"neutral","pos":"left","enter":"slide","text":"카트 정리는… 둘이 반반 해요. 공평하게.","next":"d6_050"},{"id":"d6_045","speaker":"beomi","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.comicfail","text":"시간 초과예요! 근데 저도 두 번 넘어졌어요. 무승부!","fx":"sweat","next":"d6_046"},{"id":"d6_046","speaker":"beomsuk","expression":"angry","pos":"left","enter":"slide","text":"무승부 아니고 둘 다 실격이에요. 쌀은 제자리에.","fx":"anger","next":"d6_050"},{"id":"d6_048","markMissed":["E07"],"speaker":"beomi","expression":"neutral","pos":"right","enter":"slide","bgm":"bgm.closing","text":"아… 그럼 혼자 한 바퀴만 돌고 갈게요. 1등은 저예요.","next":"d6_049"},{"id":"d6_049","speaker":"narration","text":"(출입문으로 가는데, 셔터가 반쯤 내려온 채 멈췄다.)","next":"d6_050"},{"id":"d6_050","speaker":"narration","text":"계산대 네 곳에 불이 켜졌다. 내일부터 4레인 상시 운영이래.","next":"d6_051"},{"id":"d6_051","cmd":"timeskip","clock":"03:00","ui":"clock-card","bg":"store-dark","bgm":"bgm.dawn","sfx":"freezer-hum","text":"","next":"d6_052"},{"id":"d6_052","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「(속삭임) …지금 이 방송이 들리는 분만…」","next":"d6_053"},{"id":"d6_053","cmd":"pa","speaker":"pa","text":"「(속삭임) 뒤쪽 벽으로 오세요. 발소리는… 작게.」","next":"d6_054"},{"id":"d6_054","speaker":"me","sfx":"flashlight-click","text":"(손잡이에 손전등이 달려 있다. 언제 달았지?)","next":"d6_055"},{"id":"d6_055","speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","text":"어머, 젊은이도 들었어? 나는 새벽 장 보러 일찍 왔지.","next":"d6_056"},{"id":"d6_056","speaker":"halmeoni","expression":"laugh","pos":"right","text":"분식집 할 때도 세 시면 불을 켰어. 버릇이야.","next":"d6_057"},{"id":"d6_057","cmd":"pa","speaker":"pa","text":"「(속삭임) 지게차가 순찰 중입니다. 불빛에… 닿지 마세요.」","next":"d6_058"},{"id":"d6_058","speaker":"halmeoni","expression":"neutral","pos":"right","text":"저 벽 끝에 평소엔 없는 칸이 열렸네. 금빛 상자가 있어.","emph":["금빛 상자"],"next":"d6_059"},{"id":"d6_059","choices":[{"text":"(손전등을 끄고 다가간다)","goto":"d6_061","chip":"미션 수락","set":{"aff.halmeoni":1}},{"text":"이거 들어가도 되는 데예요?","goto":"d6_060"},{"text":"(못 들은 척 집에 간다)","goto":"d6_075"}]},{"id":"d6_060","speaker":"halmeoni","expression":"laugh","pos":"right","text":"방송이 오라잖아. 점장 말은 들어야지.","next":"d6_061"},{"id":"d6_061","cmd":"mission.start","event":"E08","ui":"mission-card","text":"","target":"entrance-mat","waypoints":[{"target":"secret-shelf","item":"goldbox","n":1,"kg":30,"label":"금빛 박스 30kg"}],"stealth":{"forklifts":[{"id":"fl-1","route":["forklift-lane-back"],"speedMps":1.4,"coneDeg":40,"rangeM":9,"sfx":"forklift-beep"},{"id":"fl-2","route":["forklift-lane-cross"],"speedMps":1.2,"coneDeg":40,"rangeM":9,"sfx":"forklift-beep"}],"flashlight":{"coneDeg":40,"toggle":{"pc":"L","mobile":"손전등 버튼"},"offSpeedMul":0.6},"caughtMax":2,"onCaughtReset":"마지막 체크포인트로(박스는 카트에 그대로)","checkpoints":["secret-shelf","timesale-endcap"],"noise":"어두운 바닥 물건 cart-bump = 가까운 지게차가 소리 쪽으로 6초 돌아봄"},"resolve":"arrive","timeLimitSec":240,"startWithinSec":90,"resume":"d6_065","onMissed":"d6_075","bgm":"bgm.dawn","timed":[{"t":15,"speaker":"halmeoni","text":"쉿. 무거우니까 천천히 돌아."},{"t":60,"speaker":"pa","sfx":"pa-chime","text":"「(속삭임) 왼쪽… 아니, 손님 기준 오른쪽…」"},{"t":150,"speaker":"halmeoni","text":"입구가 보인다. 거의 다 왔어."}],"next":"d6_065"},{"id":"d6_065","cmd":"branch","on":"mission.E08.result","cases":{"success":"d6_066","partial":"d6_068","fail":"d6_070","missed":"d6_075"}},{"id":"d6_066","speaker":"narration","sfx":"gold-box-open","text":"금빛 박스가 열렸다. 반쪽짜리 쪽지와 작은 지도 한 장.","next":"d6_067"},{"id":"d6_067","speaker":"halmeoni","expression":"surprised","pos":"right","enter":"jump","sfx":"stinger.success","text":"이 글씨… 내 계란말이 레시피야. 반쪽만 있네.","emph":["반쪽"],"fx":"exclaim","next":"d6_072"},{"id":"d6_068","speaker":"narration","sfx":"gold-box-open","text":"불빛에 한 번 걸렸지만 박스는 지켰다. 안에 반쪽 쪽지.","next":"d6_069"},{"id":"d6_069","speaker":"halmeoni","expression":"surprised","pos":"right","enter":"slide","sfx":"stinger.partial","text":"어머, 내 레시피 쪽지네. 반쪽만 있어.","emph":["반쪽"],"next":"d6_072"},{"id":"d6_070","speaker":"narration","sfx":"stinger.comicfail","text":"두 번째 불빛. 금빛 박스가 스르르 칸 안으로 돌아갔다.","next":"d6_071"},{"id":"d6_071","speaker":"halmeoni","expression":"laugh","pos":"right","enter":"slide","text":"괜찮아. 안에 뭐가 있는지 나는 알 것 같거든.","next":"d6_072"},{"id":"d6_072","speaker":"halmeoni","expression":"neutral","pos":"right","text":"뒷면엔 '냉동 코너 맨 아래 칸, 전설'이라고 적혀 있어.","emph":["맨 아래 칸"],"next":"d6_073"},{"id":"d6_073","speaker":"halmeoni","expression":"laugh","pos":"right","text":"내가 젊을 때 먹던 아이스크림이야. 내일 같이 찾자.","next":"d6_080"},{"id":"d6_075","markMissed":["E08"],"speaker":"narration","bgm":"bgm.dawn","text":"(새벽 세 시. 뒤쪽 벽 너머에서 무언가 딸깍, 닫히는 소리.)","next":"d6_076"},{"id":"d6_076","speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","text":"벌써 가? 그럼 내일 냉동 코너에서 보자. 할 얘기가 있어.","next":"d6_080"},{"id":"d6_080","speaker":"halmeoni","expression":"laugh","pos":"right","sfx":"sample-tray","text":"자, 야식 누룽지. 새벽엔 이게 제일이야.","next":"d6_081"},{"id":"d6_081","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"jump","text":"할머니? 이 시간에 왜… 손님까지요?","fx":"exclaim","next":"d6_082"},{"id":"d6_082","speaker":"halmeoni","expression":"laugh","pos":"right","text":"범숙이 너도 누룽지는 탄 데만 골라 먹었잖아.","next":"d6_083"},{"id":"d6_083","speaker":"beomsuk","expression":"neutral","pos":"left","text":"…그건 탄 게 아니라 바삭한 거예요. 원칙이에요.","fx":"sweat","next":"d6_084"},{"id":"d6_084","speaker":"beomsuk","expression":"neutral","pos":"left","text":"내일 본사 감사예요. 오늘은 다들 자요. 진짜로요.","emph":["본사 감사"],"next":"d6_085"},{"id":"d6_085","choices":[{"text":"내일 제일 먼저 올게요","goto":"d6_086","set":{"aff.beomsuk":1}},{"text":"누룽지 하나만 더요","goto":"d6_087","set":{"aff.halmeoni":1}}]},{"id":"d6_086","speaker":"beomsuk","expression":"laugh","pos":"left","text":"…오픈 시간 10시예요. 9시 59분엔 오지 마세요.","next":"d6_090"},{"id":"d6_087","speaker":"halmeoni","expression":"laugh","pos":"right","text":"그래, 하나 더 먹고 가. 내일은 힘쓸 날이니까.","next":"d6_090"},{"id":"d6_090","cmd":"pa","sfx":"pa-chime","speaker":"pa","bgm":"bgm.closing","text":"「(속삭임) 새벽 방송을 마칩니다. 내일은… 크게 말하겠습니다.」","next":"d6_091"},{"id":"d6_091","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","text":"손님! 내일 본사에서 감사관이 온대요. 남색 정장이래요!","emph":["남색 정장"],"next":"d6_092"},{"id":"d6_092","speaker":"beomi","expression":"neutral","pos":"right","text":"카트 200kg이면 다들 박수 쳐 주기로 했어요. 비밀이에요.","emph":["200kg"],"next":"d6_100"},{"id":"d6_100","cmd":"day.end","stamp":1,"vitality":"by_result","storeChange":"계산대 4레인 상시 운영, 야간 조명 모드 해금, 냉동 코너 확장, 뒤쪽 벽 '비밀 창고' 표식(E08 성공·부분이면 금빛, 실패·놓침이면 희미하게)","ui":"stamp-card","text":"","nextDay":{"day":7,"title":"본사 감사의 날","hook":"남색 정장의 감사관, 체크리스트 다섯 칸. 그리고 더 큰 보라 카트","ui":"next-day-card","sfx":"stinger.nextday"},"next":"d7_000"}]