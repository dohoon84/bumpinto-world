[{"id":"w2_000","cmd":"scene.start","day":8,"week":2,"title":"보라색 월요일","subtitle":"2주차 첫날. 길 건너에 보라 깃발","ui":"daycard","bg":"entrance","bgm":"hold","sfx":"door-chime","weekStart":{"week":2,"once":"flag.w2Init","vitality":{"from":"flag.w1Vitality","rule":"floor(w1 / 2)","cap":40},"stamps":"newCard","keep":["aff","flag.spyRevealed","flag.recipeHalf","achievements"]},"next":"w2_001"},{"id":"w2_001","cmd":"branch","on":"flag.w1Ending","cases":{"A":"w2_a10","B":"w2_b10"},"default":"w2_b10"},{"id":"w2_a10","speaker":"narration","bgm":"bgm.shop","text":"입구 간판엔 '오픈 기념 세일 연장'. 풍선이 하나 늘었다.","next":"w2_a11"},{"id":"w2_a11","speaker":"beomi","expression":"laugh","pos":"right","enter":"jump","fx":"sparkle","text":"손님! 존속 기념 풍선이에요! 제가 다 불었어요!","next":"w2_a12"},{"id":"w2_a12","speaker":"beomsuk","expression":"laugh","pos":"left","enter":"slide","ui":"stamp-card-w2","text":"…어서 와요. 오늘부터 2주차 도장 카드예요.","emph":["2주차 도장 카드"],"next":"w2_a13"},{"id":"w2_a13","speaker":"beomsuk","expression":"neutral","pos":"left","text":"금도장 카드는 액자에 넣었어요. 원칙상이요.","next":"w2_a14"},{"id":"w2_a14","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「존속 확정 매장에서 알려 드립니다. 오늘도 축제입니다.」","next":"w2_a15"},{"id":"w2_a15","speaker":"me","text":"(다들 들떠 있다. 이렇게 풀어져도 되나.)","next":"w2_a16"},{"id":"w2_a16","choices":[{"text":"축하해요! 금도장 덕분이죠","goto":"w2_a17","set":{"aff.beomsuk":1}},{"text":"근데 저 보라 깃발은 뭐예요?","goto":"w2_a18"}]},{"id":"w2_a17","speaker":"beomsuk","expression":"surprised","pos":"left","fx":"sweat","text":"손님 덕… 그런 말은 원칙에 없어요. 고마워요.","next":"w2_a18"},{"id":"w2_a18","speaker":"beomi","expression":"surprised","pos":"right","text":"깃발이요? 어제부터 길 건너에 섰어요. 보라색이요.","emph":["보라색"],"next":"d8_020"},{"id":"w2_b10","speaker":"narration","bgm":"bgm.audit","text":"입구 간판엔 '리뉴얼 준비 중'. 테이프 한쪽이 들떠 있다.","next":"w2_b11"},{"speaker":"auditor","nameTag":"본사 감사관","id":"w2_b11","expression":"neutral","pos":"right","enter":"slide","sfx":"motif.auditor","stage":{"auditor":"auditor-post"},"text":"안녕하십니까. 지난주에 말씀드린 대로입니다.","next":"w2_b12"},{"speaker":"auditor","nameTag":"본사 감사관","id":"w2_b12","expression":"neutral","pos":"right","sfx":"tablet-tap","text":"한 주 더 봅니다. 일요일에 다시 오겠습니다.","emph":["일요일"],"next":"w2_b13"},{"id":"w2_b13","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"jump","fx":"sweat","text":"일, 일요일이요? 또 체크리스트 다섯 칸이에요?","next":"w2_b14"},{"speaker":"auditor","nameTag":"본사 감사관","id":"w2_b14","expression":"neutral","pos":"right","text":"칸은 그때 알려 드리죠. 오늘은 인사만입니다.","next":"w2_b15"},{"id":"w2_b15","cmd":"pa","sfx":"pa-chime","speaker":"pa","text":"「(작게) 감사관님 또 오셨습니다. 평소처럼… 평소입니다.」","next":"w2_b16"},{"id":"w2_b16","choices":[{"text":"이번 주도 매일 올게요","goto":"w2_b17","set":{"aff.beomsuk":1}},{"text":"감사관님, 태블릿에 뭐 적어요?","goto":"w2_b18"}]},{"id":"w2_b17","speaker":"beomsuk","expression":"neutral","pos":"left","text":"…매일 오시면 매일 계란 깨지 마세요. 그게 다예요.","next":"w2_b19"},{"speaker":"auditor","nameTag":"본사 감사관","id":"w2_b18","expression":"neutral","pos":"right","sfx":"tablet-tap","text":"'계란말이'라고 적혀 있습니다. 지난주 메모입니다.","next":"w2_b19"},{"id":"w2_b19","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","text":"감사관님, 길 건너 보라 깃발도 보셨어요?","next":"w2_b20"},{"speaker":"auditor","nameTag":"본사 감사관","id":"w2_b20","expression":"neutral","pos":"right","text":"봤습니다. 그것도 매장 상황이죠. 기록합니다.","stage":{"auditor":null},"next":"d8_020"},{"id":"d8_020","speaker":"narration","bgm":"bgm.tailing","sfx":"convoy-horn","stage":{"rivalboss":"squad-gate","squad":"squad-gate","spy":"squad-gate"},"text":"자동문이 열렸다. 보라 조끼 셋이 카트를 줄지어 민다.","next":"d8_021"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_021","expression":"surprised","pos":"left","enter":"slide","fx":"sweat","text":"(작게) …손님. 미안하오. 본부가 진짜로 왔소.","next":"d8_022"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_022","expression":"laugh","pos":"right","enter":"slide","sfx":"motif.rivalboss","text":"안녕하세요. 길 건너 경쟁 마트 팀장입니다.","next":"d8_023"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_023","expression":"neutral","pos":"right","sfx":"stopwatch-click","text":"오늘부터 '견학'할게요. 카트 세 대로요.","emph":["견학"],"next":"d8_024"},{"id":"d8_024","speaker":"beomsuk","expression":"angry","pos":"left","enter":"jump","fx":"anger","text":"견학은 카트 없이 하는 거예요. 원칙상.","next":"d8_025"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_025","expression":"laugh","pos":"right","text":"어머, 장도 볼 거예요. 반기철 씨, 전단지.","next":"d8_026"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_026","expression":"neutral","pos":"left","text":"…네. (전단지를 든다) 바람이 좀 부는군.","next":"d8_027"},{"id":"d8_027","speaker":"narration","sfx":"flyer-flutter","text":"자동문 바람에 보라 전단지가 입구 바닥에 흩어졌다.","next":"d8_028"},{"id":"d8_028","speaker":"beomi","expression":"surprised","pos":"right","enter":"jump","text":"으아아아! 전단지가 계산대 쪽으로 가요! 카트로요!","next":"d8_029"},{"id":"d8_029","choices":[{"text":"(카트로 쓸어 담는다)","goto":"d8_031","chip":"미션 수락","set":{"aff.beomi":1}},{"text":"전단지에 뭐라고 써 있어요?","goto":"d8_030"},{"text":"(못 본 척 장 보러 간다)","goto":"d8_036"}]},{"id":"d8_030","speaker":"narration","text":"'보라 카트 무료 대여! 길 건너 경쟁 마트'.","next":"d8_031"},{"id":"d8_031","cmd":"mission.start","event":"E16","ui":"mission-card","text":"","target":"flyer-zone","waypoints":[{"target":"flyer-zone","item":"flyer","n":12,"label":"흩어진 보라 전단지 16장 중 12장","loose":true}],"resolve":"timer","timeLimitSec":60,"earlyEnd":"scooped>=12","resume":"d8_032","onMissed":"d8_036","onCheckout":"d8_036","bgm":"bgm.tension","timed":[{"t":10,"speaker":"beomi","text":"바퀴로 밟으면 붙어요! 천천히 지나가요!"},{"t":30,"speaker":"pa","sfx":"pa-chime","text":"「바람 방향 안내드립니다. …입구에서 안쪽입니다.」"},{"t":50,"speaker":"spy","nameTag":"반기철(반값)","text":"10초요. …아니, 응원한 거 아니오."}],"next":"d8_032"},{"id":"d8_032","cmd":"branch","on":"mission.E16.result","cases":{"success":"d8_033","partial":"d8_034","fail":"d8_035","missed":"d8_036"},"default":"d8_036"},{"id":"d8_033","speaker":"beomsuk","expression":"laugh","pos":"left","sfx":"stinger.success","text":"열두 장 넘게요? 재활용함은 저쪽이에요. 칭찬이에요.","next":"d8_040"},{"id":"d8_034","speaker":"beomi","expression":"laugh","pos":"right","sfx":"stinger.partial","text":"몇 장은 냉동 코너까지 갔어요. 거기서 얼었어요!","next":"d8_040"},{"id":"d8_035","speaker":"beomi","expression":"neutral","pos":"right","sfx":"stinger.comicfail","fx":"sweat","text":"전단지가 이겼어요… 바닥이 보라색이 됐어요.","next":"d8_040"},{"id":"d8_036","markMissed":["E16"],"speaker":"narration","text":"(전단지는 범이가 빗자루로 쓸었다. 꽤 오래.)","next":"d8_040"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_040","expression":"neutral","pos":"right","enter":"slide","sfx":"stopwatch-click","text":"흠. 4분 12초. 이 매장 아침 정리 시간이에요.","next":"d8_041"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_041","expression":"laugh","pos":"right","text":"우린 2분이면 해요. 보라 카트 부대, 출발.","emph":["보라 카트 부대"],"next":"d8_042"},{"id":"d8_042","speaker":"narration","sfx":"convoy-horn","text":"보라 카트 세 대가 한 줄로 통로를 돌기 시작했다.","next":"d8_043"},{"id":"d8_043","speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","text":"젊은이, 마침 잘 왔어. 오늘 메뉴는 잔치국수야.","emph":["잔치국수"],"next":"d8_044"},{"id":"d8_044","cmd":"branch","on":"flag.w1Ending","cases":{"A":"d8_045","B":"d8_046"},"default":"d8_046"},{"id":"d8_045","speaker":"halmeoni","expression":"laugh","pos":"right","text":"존속 기념 잔치야. 국수는 길게, 오래 가라고.","next":"d8_047"},{"id":"d8_046","speaker":"halmeoni","expression":"laugh","pos":"right","text":"한 주 더 버티자는 국수야. 길게, 오래 가라고.","next":"d8_047"},{"id":"d8_047","speaker":"halmeoni","expression":"neutral","pos":"right","text":"범샘물 두 팩, 범란 두 판. 육수랑 지단이야.","emph":["범샘물 두 팩","범란 두 판"],"next":"d8_048"},{"id":"d8_048","speaker":"beomsuk","expression":"neutral","pos":"left","text":"보라 행렬이 통로를 돌아요. 박으면 안 돼요.","emph":["박으면"],"next":"d8_049"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_049","expression":"neutral","pos":"left","text":"(지나가며) 행렬은 안 멈추오. …팀장님 규칙이오.","next":"d8_050"},{"id":"d8_050","choices":[{"text":"(행렬 틈을 본다) 갈게요","goto":"d8_052","chip":"미션 수락","set":{"aff.halmeoni":1}},{"text":"행렬은 몇 바퀴 돌아요?","goto":"d8_051"}]},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_051","expression":"neutral","pos":"right","text":"손님이 다 볼 때까지요. 견학이니까요.","next":"d8_052"},{"id":"d8_052","cmd":"mission.start","event":"E15","ui":"mission-card","text":"","target":"sample-corner","waypoints":[{"target":"aisle-01-water","item":"water","n":2,"label":"범샘물 2L×6 2팩(육수)"},{"target":"aisle-01-eggs","item":"egg","n":2,"label":"범란 30구 2판(지단)"}],"convoy":{"carts":[{"id":"pv-1","kg":60},{"id":"pv-2","kg":60},{"id":"pv-3","kg":60,"driver":"spy"}],"route":["convoy-loop"],"speedMps":1.3,"gapM":2.4,"pauseAt":"timesale-endcap","pauseSec":4,"bumpRule":"행렬 카트와 부딪히면 rams +1(bumpTarget convoy). 행렬은 멈추지 않고 밀고 감"},"resolve":"arrive","timeLimitSec":240,"resume":"d8_060","onMissed":"d8_068","onCheckout":"d8_068","bgm":"bgm.tension","timed":[{"t":15,"speaker":"beomi","text":"특가 매대 앞에서 행렬이 4초씩 서요! 그때요!"},{"t":60,"speaker":"spy","nameTag":"반기철(반값)","text":"(행렬 맨 뒤) …나는 일부러 천천히 미는 거요."},{"t":120,"speaker":"pa","sfx":"pa-chime","text":"「안내 말씀. 보라 행렬은… 손님이 아닙니다. 아마도.」"},{"t":200,"speaker":"halmeoni","sfx":"timer-tick","text":"물 끓는다! 얼른 와!"}],"next":"d8_060"},{"id":"d8_060","cmd":"branch","on":"mission.E15.result","cases":{"success":"d8_061","partial":"d8_063","fail":"d8_065","missed":"d8_068"},"default":"d8_068"},{"id":"d8_061","speaker":"halmeoni","expression":"surprised","pos":"right","enter":"jump","fx":"sparkle","bgm":"bgm.shop","text":"계란이 한 알도 안 깨졌네! 행렬 틈으로 왔어?","next":"d8_062"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_062","expression":"surprised","pos":"left","enter":"slide","sfx":"stopwatch-click","text":"…행렬에 한 번도 안 닿았어요? 적어 둘게요.","next":"d8_070"},{"id":"d8_063","speaker":"halmeoni","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.partial","bgm":"bgm.shop","text":"지단 몇 장은 못 부치겠다. 괜찮아, 국수는 길어.","next":"d8_064"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_064","expression":"laugh","pos":"left","text":"(작게) 우리 카트 살짝 박은 거, 팀장님은 못 봤소.","next":"d8_070"},{"id":"d8_065","speaker":"beomi","expression":"laugh","pos":"right","enter":"slide","sfx":"stinger.comicfail","fx":"sweat","bgm":"bgm.shop","text":"행렬이랑 같이 세 바퀴 도셨어요! 견학 오신 줄요!","next":"d8_066"},{"id":"d8_066","speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","text":"물은 내가 받아 왔어. 다음엔 같이 하자.","next":"d8_070"},{"id":"d8_068","markMissed":["E15"],"speaker":"halmeoni","expression":"neutral","pos":"right","enter":"slide","bgm":"bgm.shop","text":"범이가 갖다줬어. 계란은 세 알 깨졌대.","next":"d8_070"},{"id":"d8_070","speaker":"halmeoni","expression":"laugh","pos":"right","sfx":"sample-tray","text":"자, 잔치국수. 하나 더 먹고 가.","next":"d8_071"},{"id":"d8_071","speaker":"beomsuk","expression":"surprised","pos":"left","enter":"slide","text":"…분식집 때랑 국물 색이 똑같아요.","next":"d8_072"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_072","expression":"surprised","pos":"right","enter":"slide","text":"(국물 냄새에 멈춘다) …이 냄새.","next":"d8_073"},{"speaker":"rivalboss","nameTag":"경쟁 마트 팀장","id":"d8_073","expression":"neutral","pos":"right","sfx":"stopwatch-click","text":"아니에요. 반기철 씨, 다음 견학지로.","next":"d8_074"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_074","expression":"neutral","pos":"left","text":"…한 그릇만 먹고 가겠소. 팀장님 몰래.","next":"d8_075"},{"id":"d8_075","cmd":"roam","until":{"sec":150},"text":"","chip":"자유 장보기","hint":"보라 행렬은 계속 돌아요. 박지 않게","next":"d8_078"},{"id":"d8_078","cmd":"scene.checkout","text":"","next":"d8_080"},{"id":"d8_080","speaker":"cashier","expression":"laugh","pos":"right","enter":"slide","sfx":"checkout-printer","text":"영수증에 보라 전단지가 붙어 왔어요. 떼 드릴게요~","next":"d8_081"},{"id":"d8_081","cmd":"pa","sfx":"pa-chime","speaker":"pa","bgm":"bgm.closing","text":"「견학 오신 분들… 견학은 끝났습니다. 진짜로요.」","next":"d8_082"},{"id":"d8_082","speaker":"narration","stage":{"rivalboss":null,"squad":null},"text":"보라 행렬이 줄지어 나갔다. 맨 뒤 카트만 돌아봤다.","next":"d8_083"},{"speaker":"spy","nameTag":"반기철(반값)","id":"d8_083","expression":"neutral","pos":"left","enter":"slide","text":"손님. 팀장님은 내일 '시식'으로 온다 했소.","emph":["시식"],"stage":{"spy":null},"next":"d8_084"},{"id":"d8_084","speaker":"halmeoni","expression":"laugh","pos"